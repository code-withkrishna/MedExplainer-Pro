# Copy this file to .env and replace every placeholder with a local value.

GROQ_API_KEY=<GROQ_API_KEY_PLACEHOLDER>
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
MEDEXPLAINER_LLM_PROVIDER=groq
MEDEXPLAINER_ALLOW_REMOTE_REASONING=true
MEDEXPLAINER_ALLOW_LLM_PHI=<true_or_false_placeholder>

FHIR_BASE_URL=<FHIR_BASE_URL_PLACEHOLDER>
FHIR_ACCESS_TOKEN=<FHIR_ACCESS_TOKEN_PLACEHOLDER>

MCP_TRANSPORT=<stdio_or_sse_placeholder>
MCP_HOST=<MCP_HOST_PLACEHOLDER>
MCP_PORT=<MCP_PORT_PLACEHOLDER>
MCP_ALLOW_PUBLIC_SSE=<true_or_false_placeholder>
MCP_ALLOW_UNAUTHENTICATED_SSE=<true_or_false_placeholder>
MEDEXPLAINER_MCP_AUTH_TOKEN=<MCP_BEARER_TOKEN_PLACEHOLDER>
